# Example only: adjust paths/user and install explicitly after verification.
[Unit]
Description=DevFlow GitHub event worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devflow
Group=devflow
WorkingDirectory=/opt/devflow
EnvironmentFile=/etc/devflow/devflow.env
ExecStart=/usr/bin/node /opt/devflow/.worker/scripts/github-worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
