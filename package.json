{
  "name": "devflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "build:webpack": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:prepare:test": "node --import tsx scripts/prepare-test-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "github:worker": "node --env-file-if-exists=.env .worker/scripts/github-worker.js",
    "github:worker:build": "tsc -p tsconfig.worker.json",
    "github:worker:dev": "node --env-file-if-exists=.env --import tsx scripts/github-worker.ts"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@prisma/client": "6.19.0",
    "zod": "3.25.76",
    "lucide-react": "1.34.0",
    "@tanstack/react-query": "5.90.7",
    "zustand": "5.0.15",
    "react-hook-form": "7.66.0",
    "@hookform/resolvers": "3.10.0",
    "recharts": "3.3.0",
    "motion": "12.23.24",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "marked": "16.4.2",
    "js-tokens": "4.0.0",
    "entities": "4.5.0"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "typescript": "5.9.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.9",
    "prettier": "3.6.2",
    "vitest": "3.0.6",
    "tsx": "4.20.6",
    "@playwright/test": "1.56.1",
    "dotenv": "16.6.1",
    "jsdom": "22.1.0"
  }
}
