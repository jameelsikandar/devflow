# Replace placeholders before use; never place real credentials in this template.
DATABASE_URL="postgresql://devflow:REPLACE_WITH_LOCAL_PASSWORD@localhost:5433/devflow?schema=public"
# Required only when using Compose; must match DATABASE_URL after local configuration.
POSTGRES_PASSWORD="REPLACE_WITH_LOCAL_PASSWORD"
# A separate disposable database is required for integration tests. Apply migrations there first.
# TEST_DATABASE_URL="postgresql://devflow:REPLACE_WITH_LOCAL_PASSWORD@localhost:5433/devflow_test?schema=public"
# Use the public HTTPS origin for real GitHub callbacks/webhooks (HTTPS tunnel for local setup).
APP_URL="http://localhost:3000"
# Generate: openssl rand -hex 32 (required for OAuth token and per-repository webhook-secret encryption)
TOKEN_ENCRYPTION_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
AI_API_KEY=""
# Must support Chat Completions function tools. HTTPS required except on localhost.
# Keys stay on the server; the assistant never approves its own proposals.
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4.1-mini"
# Only set to true locally to show the sample GitHub repository.
GITHUB_DEMO="false"
# Seed account password, required only for pnpm db:seed
SEED_PASSWORD=""

# Optional server-only aggregate AI request/token/rate diagnostics; no prompts or keys.
AI_DIAGNOSTICS=0

# M3.1: no global webhook secret or GitHub App key is needed.
# Workspace/repository admins connect a repository in GitHub → Connect project.
# DevFlow generates a separate secret shown once; configure the repository hook manually.
# See GITHUB_INTEGRATION.md. OAuth never creates hooks or grants webhook verification.

# M3.2 standalone worker. Authorization for optional enrichment is granted in the
# GitHub processing panel, never by placing another user's token in worker settings.
GITHUB_WORKER_CONCURRENCY=2
GITHUB_WORKER_LEASE_SECONDS=120
GITHUB_WORKER_MAX_ATTEMPTS=8
GITHUB_WORKER_POLL_MS=2000
GITHUB_WORKER_ONCE_LIMIT=25
# Optional: restrict worker claims/recovery to one GitHubRepositoryConnection.id.
# Leave UNSET for all active authorized connections, not an empty string.
# GITHUB_WORKER_CONNECTION_ID=connection_id_here
